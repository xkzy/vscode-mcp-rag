{
    "name": "vscode-mcp-rag",
    "displayName": "MCP RAG",
    "description": "Retrieval-Augmented Generation with MCP for Coder agent integration",
    "version": "0.1.0",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:vscode-mcp-rag.connect",
        "onCommand:vscode-mcp-rag.search",
        "onCommand:vscode-mcp-rag.reindex",
        "onCommand:vscode-mcp-rag.sendToCoder"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-mcp-rag.connect",
                "title": "MCP: Connect to RAG Server"
            },
            {
                "command": "vscode-mcp-rag.search",
                "title": "MCP: Search Code Context"
            },
            {
                "command": "vscode-mcp-rag.reindex",
                "title": "MCP: Reindex Project"
            },
            {
                "command": "vscode-mcp-rag.sendToCoder",
                "title": "MCP: Send to Coder Agent"
            }
        ],
        "configuration": {
            "title": "MCP RAG",
            "properties": {
                "vscode-mcp-rag.serverUrl": {
                    "type": "string",
                    "default": "http://localhost:8000",
                    "description": "URL of the MCP RAG server"
                },
                "vscode-mcp-rag.coderPath": {
                    "type": "string",
                    "default": "coder",
                    "description": "Path to the Coder agent executable"
                },
                "vscode-mcp-rag.maxResults": {
                    "type": "number",
                    "default": 5,
                    "description": "Maximum number of search results to retrieve"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mcp-explorer",
                    "title": "MCP RAG",
                    "icon": "resources/mcp-icon.svg"
                }
            ]
        },
        "views": {
            "mcp-explorer": [
                {
                    "id": "mcpContextView",
                    "name": "Code Context"
                },
                {
                    "id": "mcpHistoryView",
                    "name": "Query History"
                }
            ]
        },
        "menus": {
            "editor/context": [
                {
                    "command": "vscode-mcp-rag.search",
                    "group": "navigation"
                },
                {
                    "command": "vscode-mcp-rag.sendToCoder",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.98.0",
        "@typescript-eslint/eslint-plugin": "^5.30.0",
        "@typescript-eslint/parser": "^5.30.0",
        "eslint": "^8.13.0",
        "typescript": "^4.7.2"
    },
    "dependencies": {
        "axios": "^1.8.4"
    }
}
